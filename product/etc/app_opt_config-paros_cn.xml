<?xml version="1.0" encoding="utf-8"?>
<!--
    App optimizations device config
-->
<app-optimization version="1">

    <devconfig>
        <thermal-sensor>back_temp</thermal-sensor>
        <profile-adjuster name="0" dropFramesPC="0.95" downTimeout="2000" upFramesPC="0.92" dropJankPC="0.04" upJankPC="0.05" downCpuUtil="35" upCpuUtil="64"/>
        <profile name="0">0x40804000, 1651, 0x40804100, 1344</profile>
        <profile name="1">0x40804000, 1900, 0x40804100, 1497</profile>
        <profile name="2">0x40804000, 2054, 0x40804100, 1497</profile>
        <profile name="3">0x40804000, 2112, 0x40804100, 1651</profile>
        <profile name="4">0x40804000, 2208, 0x40804100, 1804</profile>
        <profile name="5">0x40804000, 2400, 0x40804100, 1804</profile>

        <!-- SCHEDBOOST resource opcode, value-->
        <!-- POWER_COLLAPSE_ALL resource opcode, value-->
        <!-- STORAGE_CLK_SCALING DISABLE resource opcode, value-->
        <!-- CPUBOOST_MAX_FREQ BIG Core resource opcode, MAX value-->
        <!-- CPUBOOST_MAX_FREQ LITTLE Core resource opcode, MAX value-->
        <!-- CPUBOOST_MAX_FREQ PRIME Core resource opcode, MAX value-->
        <profile name="boost1">0x40C00000, 0x1, 0x42804000, 0x1, 0x40800000, 2208, 0x40800100, 1804</profile>
        <profile name="boost2">0x40C00000, 0x1, 0x42804000, 0x1, 0x40800000, 2400, 0x40800100, 1804, 0x42C10000, 0x1</profile>

        <profile name="reading">0x40804000, 1900, 0x40804100, 1497</profile>
        <profile name="navigation">0x40804000, 2054, 0x40804100, 1651</profile>
        <profile name="video-fps">0x40800000, 1900,  0x40800100, 1497</profile>
    </devconfig>

    <!-- classified apps -->
    <optimization name="base_app" mode="normal">
        <supported-modes>video_mode, video_fullscreen_mode, camera_mode</supported-modes>
        <default-rr>auto</default-rr>
        <limit temp="44" tempClr="41" rr="90"/>
        <maxe-profile>aba</maxe-profile>
    </optimization>

    <optimization name="base_app" mode="perf">
        <supported-modes>video_mode, video_fullscreen_mode, camera_mode</supported-modes>
        <default-rr>auto</default-rr>
        <maxe-profile>aba</maxe-profile>
    </optimization>

    <optimization name="base_app" mode="powersaver">
        <supported-modes>video_mode, video_fullscreen_mode, camera_mode</supported-modes>
        <default-rr>auto</default-rr>
        <limit temp="43" tempClr="41" rr="90"/>
        <limit temp="45" tempClr="43" rr="60"/>
        <maxe-profile>aba</maxe-profile>
    </optimization>

    <optimization name="rr_opt_app" parent="base_app">
    </optimization>

    <optimization name="rr_limit_app" parent="rr_opt_app">
        <limit rr="90"/>
    </optimization>

    <optimization name="navigation_app" parent="rr_opt_app">
        <idle-fps>30</idle-fps>
    </optimization>

    <optimization name="reading_app" parent="rr_opt_app">
        <idle-fps>30</idle-fps>
    </optimization>

    <optimization name="rr_deep_opt_app" parent="rr_opt_app">
        <min-fps>30</min-fps>
    </optimization>

    <optimization name="low_latency_app" parent="base_app">
        <llm>true</llm>
    </optimization>

    <optimization name="normal_app" parent="base_app">
    </optimization>

    <optimization name="heavy_load_app">
        <boost rr="120" profile="boost2"/>
        <maxe-profile>heavy_load</maxe-profile>
        <thermal>perf</thermal>
    </optimization>

    <optimization name="heavy_load_lite_app">
        <boost profile="boost1"/>
        <thermal>perf</thermal>
    </optimization>

    <optimization name="heavy_load_app_3">
        <boost profile="boost1"/>
        <thermal>perf</thermal>
    </optimization>
    <optimization name="heavy_load_app_4">
        <boost profile="boost2"/>
        <thermal>perf</thermal>
    </optimization>

    <optimization name="teams_app" parent="base_app">
        <thermal>teams</thermal>
    </optimization>

    <!-- recognized in-app modes, will merge with app opt at runtime -->
    <optimization name="video_mode">
        <limit remove-tag="true"/>
        <default-rr>auto</default-rr>
    </optimization>

    <optimization name="video_fullscreen_mode">
        <default-rr>video</default-rr>
    </optimization>

    <optimization name="camera_mode">
        <limit remove-tag="true"/>
        <default-rr remove-tag="true"/>
        <profile-adjuster remove-tag="true"/>
        <thermal>camera</thermal>
    </optimization>

    <!-- global modes -->
    <optimization name="glass_mode">
        <thermal>glass</thermal>
    </optimization>

    <optimization name="charging_mode">
        <thermal>charging</thermal>
    </optimization>
    <optimization name="fast_charging_mode">
        <thermal>fastc</thermal>
    </optimization>

    <!-- limit rr to 90 if battery low (<20%), only for normal apps -->
    <optimization name="battery_low_mode">
        <limit rr="90" />
    </optimization>
    <optimization name="bright_throttle_mode">
        <limit temp="48" tempClr="42" brt-throttle="0:800"/>
        <limit temp="49" tempClr="43" brt-throttle="0:700"/>
        <limit temp="50" tempClr="44" brt-throttle="0:500"/>
        <limit temp="51" tempClr="45" brt-throttle="0:200"/>
    </optimization>
    
    <optimization name="camera_app">
        <limit rr="60"/>
        <autolite-rr>60</autolite-rr>
    </optimization>

    <!-- apps NOT applicable for autoRR  -->
    <optimization name="com.motorola.camera3" refs="camera_app"/>
    <optimization name="com.google.android.apps.restore"/>
    <optimization name="com.google.android.dialer"/>
    <optimization name="com.motorola.launcher3"/>
    <optimization name="android.view.cts"/>
    <optimization name="com.google.android.calculator"/>
    <optimization name="com.android.cts.graphics.framerateoverride"/>
    <optimization name="android.display.cts"/>

</app-optimization>
